# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Claude Code token sync state
.last-token-sync

# agent & test scratch artifacts (generated locally / by MCP tools)
.claude/worktrees/
.claude/scheduled_tasks.lock
# Playwright's html reporter output — CI uploads it as a build artifact instead
/playwright-report/
# Playwright viewport-verification screenshots written to the repo root by local
# layout-measurement runs. Six of these (7.70 MB) were committed by accident and
# rode along in every clone and every deployment source upload until they were
# removed. They are throwaway by definition — never commit them.
# .vercelignore carries the same two patterns as defence in depth.
verify-*.png
prod-verify-*.png
.lostpixel/
.playwright-mcp/
.antigravityignore

# local master art — not a served asset (public/ holds the built logos/favicons)
bilal-logo-master.png
