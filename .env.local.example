# Google Analytics 4 Measurement ID (public identifier, safe to expose)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Anti-automation entry gate — signs the short-lived `ba_entry` session cookie
# the official frontend mints at /api/session and protected actions require.
# MUST be set in production (>=32 random bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Without it, a known insecure dev fallback is used (local only).
SESSION_SECRET=your-32-byte-random-secret

# Visitor-count badge (/api/visitors) — server-side, keep secret.
# GA_PROPERTY_ID: numeric GA4 property id (the "p" number in the GA URL).
# Preferred auth = OAuth as the property owner (works around Google's bug that
# blocks NEW service accounts from being added to GA4 since 2025-04-23):
GA_PROPERTY_ID=532067997
GA_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GA_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GA_OAUTH_REFRESH_TOKEN=your-oauth-refresh-token
# Fallback auth (service-account JWT) — only works for SAs created before the
# bug. base64 of the key JSON:
# GA_SERVICE_ACCOUNT_JSON=base64-encoded-service-account-json
# Optional persistence — makes the count monotonic/forever (survives GA data
# retention + outages). Auto-injected by Vercel's Upstash Redis (KV) integration:
# KV_REST_API_URL=https://your-store.upstash.io
# KV_REST_API_TOKEN=your-kv-rest-token

SMTP_HOST=your-smtp-host
SMTP_PORT=your-smtp-port
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_FROM=your-smtp-from
SMTP_TO=your-smtp-to
SMTP_SECURE=false

# LinkedIn (Blog → LinkedIn cross-publish; server-side, keep secret).
# One-time setup: create a LinkedIn app (linked to a Company Page), add the
# "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn" products,
# add redirect URL http://localhost:4571/callback, then run:
#   node scripts/linkedin-auth.mjs
# and paste the printed values below. REFRESH_TOKEN is preferred (auto-renews);
# ACCESS_TOKEN is the fallback (~60-day lifetime, re-run the helper to renew).
LINKEDIN_CLIENT_ID=your-linkedin-app-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-app-client-secret
LINKEDIN_AUTHOR_URN=urn:li:person:xxxxxxxx
LINKEDIN_REFRESH_TOKEN=your-linkedin-refresh-token
# LINKEDIN_ACCESS_TOKEN=fallback-if-no-refresh-token
# LINKEDIN_TOKEN_EXPIRES — written automatically by linkedin-auth.mjs (unix seconds);
# the /post flow checks it and auto-prompts a one-click re-auth when the token is due.
